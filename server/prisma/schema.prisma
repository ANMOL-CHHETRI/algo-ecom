// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  COURIER
}

enum OrderStatus {
  PLACED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  ESEWA
  KHALTI
  FONEPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum BatchStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  COMPLETED
}

enum DeliveryStatus {
  PENDING
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum NodeType {
  DEPOT
  INTERSECTION
  CUSTOMER_STOP
}

enum InventoryType {
  SALE
  RESTOCK
  RETURN
  ADJUSTMENT
}

model User {
  id         String          @id @default(cuid())
  name       String
  email      String          @unique
  phone      String?
  password   String
  role       Role            @default(CUSTOMER)
  address    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  orders     Order[]
  cart       Cart?
  batches    DeliveryBatch[]
  deliveries Delivery[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
}

model Product {
  id                String                 @id @default(cuid())
  name              String
  slug              String                 @unique
  sku               String                 @unique
  description       String
  price             Float
  discountPrice     Float?
  stockQuantity     Int                    @default(0)
  lowStockThreshold Int                    @default(5)
  status            ProductStatus          @default(ACTIVE)
  images            String[]
  brand             String?
  categoryId        String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  category          Category               @relation(fields: [categoryId], references: [id])
  features          ProductFeature[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  inventoryTx       InventoryTransaction[]
}

model ProductFeature {
  id           String  @id @default(cuid())
  productId    String
  featureKey   String
  featureValue String
  weight       Float   @default(1.0)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryTransaction {
  id               String        @id @default(cuid())
  productId        String
  changeAmount     Int
  type             InventoryType
  referenceOrderId String?
  createdAt        DateTime      @default(now())
  product          Product       @relation(fields: [productId], references: [id])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerId      String
  totalAmount     Float
  deliveryCharge  Float         @default(50)
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PLACED)
  deliveryAddress String
  deliveryPhone   String
  roadNodeId      String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        User          @relation(fields: [customerId], references: [id])
  roadNode        RoadNode?     @relation(fields: [roadNodeId], references: [id])
  items           OrderItem[]
  delivery        Delivery?
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model DeliveryBatch {
  id              String         @id @default(cuid())
  batchNumber     String         @unique
  status          BatchStatus    @default(PENDING)
  courierId       String?
  totalDistanceKm Float?
  algorithmLog    Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  courier         User?          @relation(fields: [courierId], references: [id])
  deliveries      Delivery[]
  stops           DeliveryStop[]
}

model Delivery {
  id        String         @id @default(cuid())
  batchId   String
  orderId   String         @unique
  courierId String?
  status    DeliveryStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  batch     DeliveryBatch  @relation(fields: [batchId], references: [id])
  order     Order          @relation(fields: [orderId], references: [id])
  courier   User?          @relation(fields: [courierId], references: [id])
}

model DeliveryStop {
  id                  String        @id @default(cuid())
  batchId             String
  roadNodeId          String
  stopSequence        Int
  estimatedDistanceKm Float?
  isCompleted         Boolean       @default(false)
  batch               DeliveryBatch @relation(fields: [batchId], references: [id])
  roadNode            RoadNode      @relation(fields: [roadNodeId], references: [id])
}

model RoadNode {
  id        String         @id @default(cuid())
  name      String         @unique
  nodeType  NodeType       @default(INTERSECTION)
  latitude  Float
  longitude Float
  orders    Order[]
  stops     DeliveryStop[]
  edgesFrom RoadEdge[]     @relation("EdgeFrom")
  edgesTo   RoadEdge[]     @relation("EdgeTo")
}

model RoadEdge {
  id            String   @id @default(cuid())
  fromNodeId    String
  toNodeId      String
  distanceKm    Float
  bidirectional Boolean  @default(true)
  fromNode      RoadNode @relation("EdgeFrom", fields: [fromNodeId], references: [id])
  toNode        RoadNode @relation("EdgeTo", fields: [toNodeId], references: [id])
}
